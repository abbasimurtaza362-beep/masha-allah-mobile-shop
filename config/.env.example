# Set these through Apache/XAMPP environment variables. Do not commit real values.
APP_FORCE_HTTPS=0
APP_PUBLIC_HOST=example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-a-new-rotated-secret
SMTP_FROM_EMAIL=shop@example.com
SMTP_FROM_NAME=Masha Allah Mobile & EasyPaisa Shop
XAI_API_KEY=replace-with-your-api-key
ALLOW_INITIAL_SETUP=0
ALLOW_INITIAL_SEED=0
